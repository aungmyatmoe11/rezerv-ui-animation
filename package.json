    "test": "playwright test",
    "test:desktop": "playwright test --project=desktop",
    "test:ui": "playwright test --ui",
    "test:diagnose": "playwright test diagnose --project=desktop"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.13.0",
    "next": "^15.5.4",
